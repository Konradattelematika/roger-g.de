---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impressum | Roger G. – Try Out Tour 26"
  description="Impressum der Try-Out-Tour-Seite von Roger G."
>
  <main class="section">
    <div class="container legal">
      <h1 class="display">Impressum</h1>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        Roger G<br />
        Wertstraße 35<br />
        18057 Rostock
      </p>

      <h2>Kontakt</h2>
      <p>
        E-Mail: <a href="mailto:info@g-maltes.de">info@g-maltes.de</a>
      </p>

      <h2>Verantwortlich</h2>
      <p>Geschäftsführer: Gregor Kurtz</p>

      <h2>Steuernummer</h2>
      <p>079/111/05785</p>

      <p><a href="/">← Zurück zur Tour</a></p>
    </div>
  </main>
</Layout>

<style>
  .legal {
    max-width: 42rem;
    display: grid;
    gap: var(--space-2);
  }
  .legal h1 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }
  .legal h2 {
    font-size: var(--text-lg);
    margin-top: var(--space-2);
  }
</style>
