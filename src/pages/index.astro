---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import TourDates from '../components/TourDates.astro';
import Signup from '../components/Signup.astro';
import About from '../components/About.astro';
import {
  tourName,
  tourDescription,
  tourDates,
  soFreundeName,
  soFreundeDescription,
  soFreundeDates,
} from '../data/tour';
---

<Layout
  title="Roger G. – Try Out Tour 2026 | Termine & Tickets"
  description="Roger G. testet sein neues Comedy-Programm live: Alle Termine und Tickets der Try Out Tour 2026. Kleine Bühnen, neues Material, ungefiltert."
>
  <main>
    <Hero />
    <Marquee />
    <TourDates
      id="termine"
      heading="Termine"
      annotation="Klein. Nah. Zum ersten Mal."
      watermark="26"
      schemaName={tourName}
      schemaDescription={tourDescription}
      dates={tourDates}
    />
    <TourDates
      id="so-freunde"
      heading="So Freunde!"
      annotation="Letzte Runde"
      watermark="!"
      schemaName={soFreundeName}
      schemaDescription={soFreundeDescription}
      dates={soFreundeDates}
      note="Die große Tour, mit der alles anfing – und jetzt die letzte Runde: fünf Shows im März 2027, Rostock ist in die Stadthalle hochverlegt. Ist deine Show schon ausverkauft? Trag dich unten in die Warteliste ein, dann hörst du als Erste:r, wenn noch Tickets frei werden."
    />
    <Signup />
    <About />
  </main>
</Layout>
