---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import TourDates from '../components/TourDates.astro';
import AbgeblasenHead from '../components/AbgeblasenHead.astro';
import Signup from '../components/Signup.astro';
import About from '../components/About.astro';
import {
  tourName,
  tourDescription,
  soFreundeName,
  soFreundeDescription,
  abgeblasenName,
  abgeblasenDescription,
} from '../data/tour';
import { getShows } from '../data/shows';
import { hasUpcoming } from '../lib/dates';

// Termine = tour.ts + System One (Build-Zeit, src/data/shows.ts).
// Programme aus System One, die weder Try Out noch So Freunde sind (z. B. eine
// neue Tour), bekommen je eine eigene Liste unter den beiden bestehenden –
// Überschrift „Neue Termine", Programmname als Annotation. Leer → keine Sektion.
const shows = await getShows();
// Abgeblasen (neue Tour): eigener Abschnitt direkt unter dem Laufband, erscheint
// automatisch mit dem ersten Termin (Enthüllung steuert das Management über
// „sichtbar“ in System One). Dann schalten Hero-CTA, Laufband und Seitentitel mit um.
const hasAbg = hasUpcoming(shows.abgeblasen);
const pageTitle = hasAbg
  ? 'Roger G. – Abgeblasen & Try Out Tour | Termine & Tickets'
  : 'Roger G. – Try Out Tour 2026 | Termine & Tickets';
const pageDescription = hasAbg
  ? 'Roger G. live: alle Termine und Tickets der neuen Tour „Abgeblasen" und der Try Out Tour. Stand-up-Comedy, neues Material, ungefiltert.'
  : 'Roger G. testet sein neues Comedy-Programm live: Alle Termine und Tickets der Try Out Tour 2026. Kleine Bühnen, neues Material, ungefiltert.';
const slug = (s: string) =>
  s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'termine';
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <Hero />
    <Marquee />
    {
      hasAbg && (
        <TourDates
          id="abgeblasen"
          theme="abg"
          heading="Abgeblasen"
          annotation="Die neue Tour"
          watermark=""
          schemaName={abgeblasenName}
          schemaDescription={abgeblasenDescription}
          dates={shows.abgeblasen}
        >
          <AbgeblasenHead slot="head" headingId="abgeblasen-heading" />
        </TourDates>
      )
    }
    <TourDates
      id="termine"
      heading="Termine"
      annotation="Klein. Nah. Zum ersten Mal."
      watermark="26"
      schemaName={tourName}
      schemaDescription={tourDescription}
      dates={shows.tryout}
    />
    <TourDates
      id="so-freunde"
      heading="So Freunde!"
      annotation="Letzte Runde"
      watermark="!"
      schemaName={soFreundeName}
      schemaDescription={soFreundeDescription}
      dates={shows.soFreunde}
      note="Die große Tour, mit der alles anfing – und jetzt die letzte Runde: fünf Shows im März 2027, Rostock ist in die Stadthalle hochverlegt. Ist deine Show schon ausverkauft? Trag dich unten in die Warteliste ein, dann hörst du als Erste:r, wenn noch Tickets frei werden."
    />
    {
      shows.other.map((list) => (
        <TourDates
          id={`neu-${slug(list.production)}`}
          heading="Neue Termine"
          annotation={list.production}
          watermark="Neu"
          schemaName={`Roger G – ${list.production}`}
          schemaDescription={`Stand Up Comedy: Roger G live – ${list.production}.`}
          dates={list.dates}
        />
      ))
    }
    <Signup />
    <About />
  </main>
</Layout>
