---
import { tourDates, tourName, tourDescription } from '../data/tour';

// Datum wie auf dem Plakat: "11 SEP" groß in Bubble, Wochentag + Jahr klein
const dayFmt = new Intl.DateTimeFormat('de-DE', { day: '2-digit' });
const monthFmt = new Intl.DateTimeFormat('de-DE', { month: 'short' });
const metaFmt = new Intl.DateTimeFormat('de-DE', {
  weekday: 'long',
  year: 'numeric',
});
const posterDate = (iso: string) => {
  const d = new Date(iso);
  return {
    big: `${dayFmt.format(d)} ${monthFmt.format(d).replace('.', '')}`,
    meta: metaFmt.format(d),
  };
};

// Schema.org: eine ComedyEvent-Entity pro Termin → Rich Results in Google
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': tourDates.map((d) => ({
    '@type': 'ComedyEvent',
    name: `${tourName} – ${d.city}`,
    description: tourDescription,
    startDate: d.date,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    performer: { '@type': 'Person', name: 'Roger G.' },
    location: {
      '@type': 'Place',
      name: d.venue,
      address: {
        '@type': 'PostalAddress',
        addressLocality: d.city,
        addressCountry: 'DE',
        ...(d.street ? { streetAddress: d.street } : {}),
        ...(d.postalCode ? { postalCode: d.postalCode } : {}),
      },
    },
    offers: {
      '@type': 'Offer',
      url: d.ticketUrl,
      availability: d.soldOut
        ? 'https://schema.org/SoldOut'
        : 'https://schema.org/InStock',
    },
  })),
};
---

<section class="section" id="termine" aria-labelledby="termine-heading">
  <div class="container">
    <h2 class="display section-title" id="termine-heading">Termine</h2>

    <ol class="dates">
      {
        tourDates.map((d) => (
          <li class="date-row">
            <time class="date-when" datetime={d.date}>
              <span class="date-big">{posterDate(d.date).big}</span>
              <span class="date-meta">{posterDate(d.date).meta}</span>
            </time>
            <div class="date-where">
              <span class="date-city">{d.city}</span>
              <span class="date-venue">{d.venue}</span>
            </div>
            {d.soldOut ? (
              <span class="date-soldout">Ausverkauft</span>
            ) : (
              <a class="btn date-btn" href={d.ticketUrl}>
                Tickets für {d.city}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .section-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }

  .dates {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  /* Plakat-Übersetzung: Datum in Pink-Bubble, Stadt/Venue in fettem Weiß */
  .date-row {
    display: grid;
    gap: var(--space-1);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
    backdrop-filter: blur(4px);
  }

  .date-when {
    display: grid;
    gap: 0.15em;
  }

  .date-big {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    color: var(--pink);
    text-shadow: var(--shadow-title);
    text-transform: uppercase;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .date-meta {
    color: var(--ink-dim);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .date-city {
    display: block;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--text-lg);
    line-height: 1.15;
    text-shadow: var(--glow-pink);
  }

  .date-venue {
    color: var(--ink-dim);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .date-soldout {
    color: var(--pink);
    font-family: var(--font-display);
    text-transform: uppercase;
    align-self: center;
  }

  .date-btn {
    justify-self: start;
  }

  /* Ab Tablet: dreispaltige Zeile */
  @media (min-width: 640px) {
    .date-row {
      grid-template-columns: minmax(10rem, max-content) 1fr auto;
      align-items: center;
      column-gap: var(--space-3);
    }
    .date-btn {
      justify-self: end;
    }
  }
</style>
