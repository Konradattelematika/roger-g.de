---
import type { TourDate } from '../data/tour';
import { isPast, posterDate } from '../lib/dates';

interface Props {
  /** Anker-ID der Sektion, z. B. "termine" */
  id: string;
  heading: string;
  annotation: string;
  /** Großes Hintergrund-Wasserzeichen (z. B. "26" oder "!") */
  watermark: string;
  /** Tour-Name für Schema.org */
  schemaName: string;
  /** Tour-Beschreibung für Schema.org */
  schemaDescription: string;
  dates: TourDate[];
  /** Optionaler Einleitungssatz unter der Headline */
  note?: string;
}

const { id, heading, annotation, watermark, schemaName, schemaDescription, dates, note } =
  Astro.props;

// Datum wie auf dem Plakat: "11 SEP" groß in Bubble, Wochentag + Jahr klein –
// posterDate() rechnet in Europe/Berlin (src/lib/dates.ts).
// Rechte Spalte je Karte: Ticket-Button – oder ein Label, wenn die Show
// ausverkauft oder (Berliner Kalendertag, zur Build-Zeit) schon gespielt ist.
// Ein Ticketlink für eine gespielte Show wäre falsch; nach jeder Show neu deployen.
const now = new Date();
const status = (d: TourDate): 'tickets' | 'ausverkauft' | 'vorbei' =>
  isPast(d.date, now) ? 'vorbei' : d.soldOut ? 'ausverkauft' : 'tickets';

// Schema.org: eine ComedyEvent-Entity pro Termin → Rich Results in Google
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': dates.map((d) => ({
    '@type': 'ComedyEvent',
    name: `${schemaName} – ${d.city}`,
    description: schemaDescription,
    startDate: d.date,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    performer: { '@type': 'Person', name: 'Roger G.' },
    location: {
      '@type': 'Place',
      name: d.venue,
      address: {
        '@type': 'PostalAddress',
        addressLocality: d.city,
        addressCountry: 'DE',
        ...(d.street ? { streetAddress: d.street } : {}),
        ...(d.postalCode ? { postalCode: d.postalCode } : {}),
      },
    },
    offers: {
      '@type': 'Offer',
      url: d.ticketUrl,
      availability: d.soldOut
        ? 'https://schema.org/SoldOut'
        : 'https://schema.org/InStock',
    },
  })),
};
---

<section class="section dates-section" id={id} aria-labelledby={`${id}-heading`}>
  <span class="watermark dates-watermark" aria-hidden="true">{watermark}</span>

  <div class="container">
    <div class="dates-head">
      <h2 class="display section-title" id={`${id}-heading`}>{heading}</h2>
      <p class="annotation">{annotation}</p>
    </div>
    {note && <p class="dates-note">{note}</p>}

    <ol class="dates">
      {
        dates.map((d) => (
          <li class="date-row">
            <time class="date-when" datetime={d.date}>
              <span class="date-big">{posterDate(d.date).big}</span>
              <span class="date-meta">{posterDate(d.date).meta}</span>
            </time>
            <div class="date-where">
              <span class="date-city">{d.city}</span>
              <span class="date-venue">{d.venue}</span>
            </div>
            {status(d) === 'tickets' ? (
              <a class="btn date-btn" href={d.ticketUrl} target="_blank" rel="noopener">
                Tickets für {d.city}
              </a>
            ) : (
              <span class="date-soldout">{status(d) === 'vorbei' ? 'Vorbei' : 'Ausverkauft'}</span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .dates-section {
    position: relative;
    overflow: clip;
    /* weicher rosa Lichtkegel hinter den Karten */
    background:
      radial-gradient(60rem 30rem at 70% 0%, rgb(232 144 198 / 0.14), transparent 70%);
  }

  .dates-watermark {
    top: -0.05em;
    right: -0.08em;
  }

  .dates-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-bottom: var(--space-4);
  }

  .dates-note {
    color: var(--ink-dim);
    max-width: 42rem;
    margin-top: calc(var(--space-4) * -1 + var(--space-1));
    margin-bottom: var(--space-4);
  }

  .section-title {
    font-size: var(--text-xl);
  }

  .dates {
    list-style: none;
    counter-reset: showNr;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  /* Plakat-Übersetzung: Datum in Pink-Bubble, Stadt/Venue in fettem Weiß.
     Karten wie schief aufgeklebte Sticker + Hover-Lift. */
  .date-row {
    counter-increment: showNr;
    position: relative;
    display: grid;
    gap: var(--space-1);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
    backdrop-filter: blur(4px);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }
  .date-row:nth-child(odd) {
    rotate: -0.35deg;
  }
  .date-row:nth-child(even) {
    rotate: 0.35deg;
  }
  .date-row:hover {
    transform: translateY(-4px);
    border-color: rgb(232 144 198 / 0.65);
    background: rgb(255 255 255 / 0.13);
    box-shadow: 0 14px 34px rgb(47 26 41 / 0.35), 0 0 30px rgb(232 144 198 / 0.2);
  }

  /* Laufende Nummer als Watermark in der Kartenecke */
  .date-row::after {
    content: '0' counter(showNr);
    position: absolute;
    top: 0.4rem;
    right: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: rgb(255 255 255 / 0.14);
    pointer-events: none;
  }

  .date-when {
    display: grid;
    gap: 0.15em;
  }

  .date-big {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem);
    color: var(--pink);
    text-shadow: var(--shadow-title);
    text-transform: uppercase;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .date-meta {
    color: var(--ink-dim);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .date-city {
    display: block;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--text-lg);
    line-height: 1.15;
    text-shadow: var(--glow-pink);
  }

  .date-venue {
    color: var(--ink-dim);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .date-soldout {
    color: var(--pink);
    font-family: var(--font-display);
    text-transform: uppercase;
    align-self: center;
  }

  /* Mobil: Ticket-Button volle Breite → klare Tap-Fläche */
  .date-btn {
    justify-self: stretch;
    text-align: center;
    margin-top: var(--space-1);
  }

  /* Ab Tablet: dreispaltige Zeile */
  @media (min-width: 640px) {
    .date-row {
      grid-template-columns: minmax(10rem, max-content) 1fr auto;
      align-items: center;
      column-gap: var(--space-3);
    }
    .date-btn {
      justify-self: end;
      margin-top: 0;
    }
    .date-row::after {
      top: auto;
      bottom: 0.3rem;
      right: auto;
      left: 0.9rem;
      font-size: 1.3rem;
    }
  }
</style>
