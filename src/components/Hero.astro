---
// Hero = das Plakat selbst.
// Mobil: textfreies Plakatmotiv (motiv-*.avif/webp) als Full-Bleed-Hintergrund,
// Typo-Overlay wie auf dem Plakat (Kicker + Titel oben, CTA unten) –
// ein sauberer Screen, nichts abgeschnitten.
// Desktop: Typo links, das echte Tourplakat (plakat-*) als schwebendes
// Poster rechts. Ein einziges <img> (LCP, eager); die <source>-Elemente
// wählen das Asset per Media Query.
// Der Burst-Sticker existiert zweimal (Flow-Element mobil / Poster-Ecke
// Desktop), sichtbar ist immer nur einer.
import { getShows } from '../data/shows';
import { nextShow, nextShowLabel } from '../lib/dates';

// „Nächste Show" = früheste noch nicht vergangene Show (Berliner Kalendertag,
// zur Build-Zeit ausgewertet → nach jeder Show neu deployen). Vorher stand hier
// stur tourDates[0], sodass ab dem 12.09.2026 eine gespielte Show als „nächste"
// live stand. Ohne bevorstehende Show entfällt die Zeile (animations.ts prüft das).
// Termine aus tour.ts + System One (src/data/shows.ts).
const { tryout, abgeblasen } = await getShows();
const next = nextShow(tryout.filter((d) => !d.cancelled));
const nextLabel = next ? nextShowLabel(next) : null;
---

<header class="hero">
  <div class="container hero-inner">
    <div class="hero-stage" data-hero="stage">
      <picture class="hero-media" data-hero="media">
        <source
          media="(min-width: 900px)"
          type="image/avif"
          srcset="/img/plakat-480.avif 480w, /img/plakat-768.avif 768w, /img/plakat-1080.avif 1080w"
          sizes="32vw"
        />
        <source
          media="(min-width: 900px)"
          type="image/webp"
          srcset="/img/plakat-480.webp 480w, /img/plakat-768.webp 768w, /img/plakat-1080.webp 1080w"
          sizes="32vw"
        />
        <source
          media="(max-width: 599px)"
          type="image/avif"
          srcset="/img/motiv-hoch-480.avif 480w, /img/motiv-hoch-768.avif 768w"
          sizes="100vw"
        />
        <source
          media="(max-width: 599px)"
          type="image/webp"
          srcset="/img/motiv-hoch-480.webp 480w, /img/motiv-hoch-768.webp 768w"
          sizes="100vw"
        />
        <source
          type="image/avif"
          srcset="/img/motiv-480.avif 480w, /img/motiv-768.avif 768w, /img/motiv-1080.avif 1080w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/img/motiv-480.webp 480w, /img/motiv-768.webp 768w, /img/motiv-1080.webp 1080w"
          sizes="100vw"
        />
        <img
          src="/img/motiv-768.webp"
          width="1999"
          height="2053"
          alt="Roger G. lehnt sich mit Cap und Sonnenbrille im Fisheye-Look vor einem pastellfarbenen Plattenbau ins Bild."
          loading="eager"
          fetchpriority="high"
        />
      </picture>

      <div class="burst hero-burst-desktop" data-hero="sticker" aria-hidden="true">
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <polygon
            points="50,0 58,14 73,5 74,22 91,18 84,33 100,38 87,50 100,62 84,67 91,82 74,78 73,95 58,86 50,100 42,86 27,95 26,78 9,82 16,67 0,62 13,50 0,38 16,33 9,18 26,22 27,5 42,14"
          />
        </svg>
        <span class="burst-label">
          <span class="burst-big">100&thinsp;%</span>
          <span class="burst-small">ungetestet</span>
        </span>
      </div>
    </div>

    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-top">
      <p class="hero-kicker" data-hero="kicker">Stand Up Comedy · Neues Programm</p>
      <h1 class="hero-title">
        <span class="display hero-name" data-hero="name">Roger&nbsp;G.</span>
        <span class="subline hero-tour" data-hero="line">
          Try&nbsp;Out Tour&nbsp;26
        </span>
      </h1>
    </div>

    <div class="hero-bottom">
      <p class="hero-copy" data-hero="sub">
        Neues Material, zum ersten Mal live – ungefiltert und ohne
        Sicherheitsnetz. Was floppt, habt nur ihr gesehen.
      </p>
      <div class="hero-actions" data-hero="cta">
        <a class="btn hero-btn" href={abgeblasen.length > 0 ? '#abgeblasen' : '#termine'}>Zu den Terminen</a>
        <div class="burst hero-burst-mobile" data-hero="sticker" aria-hidden="true">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <polygon
              points="50,0 58,14 73,5 74,22 91,18 84,33 100,38 87,50 100,62 84,67 91,82 74,78 73,95 58,86 50,100 42,86 27,95 26,78 9,82 16,67 0,62 13,50 0,38 16,33 9,18 26,22 27,5 42,14"
            />
          </svg>
          <span class="burst-label">
            <span class="burst-big">100&thinsp;%</span>
            <span class="burst-small">ungetestet</span>
          </span>
        </div>
        <a class="btn-ghost hero-ghost" href="#about">Was ist ’ne Try-Out-Show?</a>
      </div>
      {nextLabel && (
        <p class="hero-next" data-hero="next">
          Nächste Show&ensp;·&ensp;<strong>{nextLabel}</strong>
        </p>
      )}
    </div>
  </div>

  <svg class="star hero-star" style="top: 21%; right: 7%; --star-size: 1.5rem" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0Z" />
  </svg>
  <svg class="star star--white hero-star" style="top: 9%; left: 56%; --star-size: 1rem" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0Z" />
  </svg>
  <svg class="star hero-star hero-star-lg" style="bottom: 33%; left: 3.5%; --star-size: 2rem" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0Z" />
  </svg>
  <svg class="star star--white hero-star hero-star-desktop" style="top: 64%; left: 44%; --star-size: 1.2rem" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12C7 11 11 7 12 0Z" />
  </svg>
</header>

<style>
  /* ── Basis (mobile-first): Hero = Plakat im Vollbild ─────────── */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--band-h));
    display: grid;
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    padding-top: max(1.4rem, env(safe-area-inset-top));
    padding-bottom: 1.6rem;
  }

  /* Stage bricht mobil aus dem Container aus (Full-Bleed, 100vw),
     Bezugsrahmen für top/bottom ist der positionierte .hero */
  .hero-stage {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
  }

  .hero-media,
  .hero-media img {
    width: 100%;
    height: 100%;
  }
  .hero-media img {
    object-fit: cover;
    object-position: 52% center;
  }

  /* Scrim: oben leicht, unten kräftig – Typo bleibt auf dem Foto lesbar */
  .hero-scrim {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    background:
      linear-gradient(180deg, rgb(85 55 74 / 0.65) 0%, rgb(85 55 74 / 0) 30%),
      linear-gradient(180deg, rgb(47 26 41 / 0) 46%, rgb(47 26 41 / 0.85) 90%);
  }

  /* Text-Ebenen über den Scrim heben */
  .hero-top,
  .hero-bottom {
    position: relative;
  }

  .hero-kicker {
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-shadow: 0 1px 10px rgb(47 26 41 / 0.7);
  }

  .hero-title {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.12em;
    font-size: clamp(3rem, 16vw, 7.5rem);
  }

  .hero-name {
    font-size: 1em;
    line-height: 0.98;
    letter-spacing: 0.01em;
  }

  /* Subline wie auf dem Plakat: weiß, fett, Glow – kleiner als der Titel */
  .hero-tour {
    font-size: 0.4em;
    line-height: 1.12;
  }

  /* Unterer Block klebt am Viewport-Boden, Gesicht bleibt frei */
  .hero-bottom {
    margin-top: auto;
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .hero-copy {
    max-width: 30ch;
    color: var(--ink);
    font-size: var(--text-md);
    line-height: 1.5;
    font-weight: 400;
    text-shadow: 0 1px 12px rgb(47 26 41 / 0.85);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  /* Mobiler Sticker: sitzt neben dem CTA in der Zeile (kollisionsfrei) */
  .hero-burst-mobile {
    --burst-size: 5.6rem;
    margin-block: -0.4rem;
  }
  .hero-burst-desktop {
    display: none;
  }

  /* Ghost-Link mobil in eigener Zeile */
  .hero-ghost {
    flex-basis: 100%;
    text-shadow: 0 1px 10px rgb(47 26 41 / 0.7);
  }

  .hero-next {
    color: var(--ink-dim);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-shadow: 0 1px 10px rgb(47 26 41 / 0.7);
  }
  .hero-next strong {
    color: var(--ink);
  }

  .hero-star-desktop {
    display: none;
  }

  /* ── Desktop: Typo links, schwebendes Poster rechts ──────────── */
  @media (min-width: 900px) {
    .hero {
      /* Band bleibt auch hier im ersten Viewport sichtbar */
      min-height: calc(100svh - var(--band-h));
    }

    .hero-scrim {
      display: none;
    }

    .hero-inner {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      grid-template-areas:
        'top stage'
        'bottom stage';
      align-content: center;
      column-gap: var(--space-5);
      row-gap: var(--space-3);
      padding-block: var(--space-4);
    }

    .hero-top {
      grid-area: top;
      align-self: end;
    }
    .hero-bottom {
      grid-area: bottom;
      align-self: start;
      margin-top: 0;
      gap: var(--space-2);
    }

    /* Stage wird vom Full-Bleed-Hintergrund zum physischen Poster */
    .hero-stage {
      position: relative;
      top: auto;
      bottom: auto;
      left: auto;
      margin-left: 0;
      grid-area: stage;
      align-self: center;
      justify-self: end;
      width: min(30vw, 23rem);
      rotate: 2.5deg;
      border-radius: 12px;
      box-shadow:
        0 14px 44px rgb(47 26 41 / 0.45),
        0 0 70px rgb(232 144 198 / 0.4);
    }
    .hero-media,
    .hero-media img {
      height: auto;
    }
    .hero-media img {
      aspect-ratio: 768 / 1086; /* Poster-Ratio → kein Layout-Shift */
      object-fit: contain;
      object-position: center;
      border-radius: 12px;
    }

    .hero-burst-mobile {
      display: none;
    }
    .hero-burst-desktop {
      display: grid;
      position: absolute;
      top: -1.6rem;
      left: -2.4rem;
      --burst-size: 8.2rem;
      rotate: -14deg;
      z-index: 2;
    }

    .hero-kicker {
      text-shadow: none;
    }
    .hero-copy {
      max-width: 36ch;
      font-size: var(--text-lg);
      color: var(--ink-dim);
      text-shadow: none;
    }
    .hero-btn {
      font-size: var(--text-lg);
      padding: 0.75em 1.5em;
    }
    .hero-ghost {
      flex-basis: auto;
      text-shadow: none;
    }
    .hero-next,
    .hero-next strong {
      text-shadow: none;
    }

    .hero-star-desktop {
      display: block;
    }
  }

  /* Sehr hohe Mobil-Screens: Titel etwas größer erlauben */
  @media (max-width: 899px) and (min-height: 800px) {
    .hero-title {
      font-size: clamp(3.2rem, 17vw, 5rem);
    }
  }
</style>
